# Copy to .env.local

# Required for the Brain (grading, analysis, comps research, listing generation)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — connects eBay to auto-pull views and sold price/date per listing
# instead of typing them in. From your eBay Developer account's app keys.
# EBAY_ENV=production            # or "sandbox" while testing
# EBAY_CLIENT_ID=your-app-id
# EBAY_CLIENT_SECRET=your-cert-id
# EBAY_RUNAME=your-runame          # see README for how this is set up
