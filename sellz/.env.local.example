# Copy to .env.local for local dev; set the same names in Railway for deploys.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is the direct connection Prisma needs for schema pushes.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth (NextAuth / Auth.js v5)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# This also signs the eBay OAuth state parameter, so eBay won't connect without it.
AUTH_SECRET=

# Your public origin, e.g. https://levoz.app
NEXTAUTH_URL=http://localhost:3002

# Google sign-in is OPTIONAL — email/password works without it, and the sign-in
# page hides the Google button when these are absent.
#
# From Google Cloud Console. Authorised redirect URI must be exactly:
#   <NEXTAUTH_URL>/api/auth/callback/google
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (Auth.js's own naming) are read as a
# fallback, so either pair works rather than one being silently ignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI (platform-funded — sellers never supply a key)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# eBay
# ---------------------------------------------------------------------------
# EBAY_RUNAME is eBay's RuName, not a URL. Its "auth accepted URL" must point at
# <PUBLIC_SITE_URL>/api/ebay/callback.
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# Opt-in, and only works if eBay approved your keyset for the Limited Release
# Marketplace Insights API. Without it, comps fall back to asking prices.
# EBAY_MARKETPLACE_INSIGHTS=true

# ---------------------------------------------------------------------------
# Photos (Cloudflare R2)
# ---------------------------------------------------------------------------
# The bucket stays private — images are served through /api/photos/[id].
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=levoz-photos

# ---------------------------------------------------------------------------
# Payments (Stripe)
# ---------------------------------------------------------------------------
# Price ids come from the recurring prices created in the Stripe dashboard.
# Billing routes degrade with a clear message when these are absent.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# ---------------------------------------------------------------------------
# Email (Resend) — optional
# ---------------------------------------------------------------------------
# Only used for the nightly digest of changes the Brain applied on its own.
# Without these the digest is silently skipped; nothing else is affected.
# EMAIL_FROM must be on a domain verified in Resend, or sends are rejected.
RESEND_API_KEY=
EMAIL_FROM="LevoZ <listings@yourdomain.com>"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# REQUIRED. The cron routes act on every tenant and refuse to run without this
# — they fail closed rather than being wide open when it is unset.
CRON_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute public origin. eBay fetches listing photos from URLs built on this,
# so in production it must be internet-reachable, not localhost — if it is
# wrong, listings publish successfully with no images.
#
# When unset, the app falls back to RAILWAY_PUBLIC_DOMAIN (which Railway injects
# automatically) so a fresh deploy works before a custom domain exists. Set this
# explicitly once you have a domain.
PUBLIC_SITE_URL=http://localhost:3002

# Do NOT set PORT here for a Railway deploy — the platform provides it and the
# start script reads it. It only matters for local dev, where it defaults to 3002.
