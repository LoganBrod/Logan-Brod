// LevoZ multi-tenant schema.
//
// Everything a seller owns hangs off User. Nested value objects that were
// plain TypeScript sub-objects in the old single-JSON store (outcome, cost,
// comps, brainScore, ...) stay as Json columns: they are always read and
// written as a whole with their parent row, never queried across, so
// normalising them would add joins without buying anything.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth + tenancy
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?

  /// Set only for email/password signups; Google-only users have none.
  passwordHash String?

  plan                 String  @default("free")
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?

  /// Usage counters, reset monthly by the cron. Limits are always enforced
  /// from these columns, never from the JWT — a plan change made by a Stripe
  /// webhook must take effect without waiting for the user to sign in again.
  listingsUsedThisMonth Int      @default(0)
  aiCallsUsedThisMonth  Int      @default(0)
  usageResetAt          DateTime @default(now())

  /// Was a single global value in the old store; it is per-seller now.
  lastResearchAt DateTime?

  /// Unguessable component of this seller's inbound forwarding address, e.g.
  /// sale-<token>@in.example.com. Depop publishes no API, so a forwarded sale
  /// email is how a Depop sale reaches us. Null until they set forwarding up.
  ///
  /// Indexed but deliberately NOT @unique. `prisma db push` treats adding a
  /// unique constraint to a populated table as potentially destructive and
  /// refuses without --accept-data-loss — and arming that flag permanently in
  /// the deploy would mean a future schema edit could silently drop a column
  /// of customer data. The constraint was only ever defence in depth: the
  /// token is 24 bytes of CSPRNG output, so collision is not a real failure
  /// mode, and lib/inboundEmail checks for one before minting anyway. Worth
  /// restoring as a real migration once this project moves off db push.
  inboundToken String?

  createdAt DateTime @default(now())

  accounts     Account[]
  inboundSales InboundSale[]
  sessions     Session[]
  listings     Listing[]
  proposals    Proposal[]
  seedListings SeedListing[]
  photos       Photo[]
  settings     SellerSettings?
  playbook     Playbook?
  ebayTokens   EbayTokens?

  @@index([inboundToken])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Seller data
// ---------------------------------------------------------------------------

model Listing {
  /// Supplied by the app rather than defaulted, because the id appears in
  /// URLs the client already holds before the row is written.
  id     String @id
  userId String

  platform    String
  title       String @db.Text
  description String @db.Text
  price       Float
  category    String
  condition    String
  tags        String[]
  photosNote  String @db.Text
  status      String
  source      String

  outcome   Json?
  /// Depop draft plus the manual tracking state that stands in for the API
  /// Depop doesn't offer. Metrics themselves live in `outcome`, shared with
  /// eBay, so analytics and the playbook treat both platforms alike.
  depop     Json?
  cost      Json?
  comps     Json?
  brainScore Json?
  diagnosis Json?
  retail    Json?
  shipping  Json?

  experimentId String?

  ebayItemId      String?
  ebaySku         String?
  ebayOfferId     String?
  ebayListingType String?
  ebayCategoryId  String?
  ebayAspects     Json?
  itemSpecifics   Json?

  photos    String[]
  imageUrls String[]

  packageWeightOz      Float?
  packageDimensionsIn  Json?

  relistHistory     Json?
  relistCadenceDays Int?
  lastRelistedAt    DateTime?

  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  createdAt          DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, ebayItemId])
}

model SellerSettings {
  userId String @id

  niche      String @db.Text
  platforms  String
  shipping   String
  style      String

  automationLevel String  @default("manual")
  autoApplyRules  Json?
  relistEnabled   Boolean @default(false)

  defaultRelistDays      Int?
  defaultPackageWeightOz Float?
  autoPublishThreshold   Int @default(0)
  autoAcceptOfferPct     Int @default(0)

  /// Nightly email about changes the Brain applied on its own. Defaults on,
  /// because those changes go live on eBay without the seller present.
  emailDigest Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Playbook {
  userId String @id

  summary            String @db.Text
  listingGuidelines  String @db.Text
  pricingGuidelines  String @db.Text
  avoid              String @db.Text
  experimentResults  String? @db.Text
  experiments        Json?
  actionCards        Json?
  updatedAt          DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SeedListing {
  id     String @id
  userId String

  description String  @db.Text
  source      String?
  stats       String?
  addedAt     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, addedAt])
}

model Proposal {
  id     String @id
  userId String

  /// Intentionally a plain column rather than a foreign key: proposals are
  /// kept as history and the UI already renders "Listing removed", so a
  /// deleted listing should orphan its proposals, not erase them.
  listingId String

  kind      String
  summary   String @db.Text
  rationale String @db.Text

  currentPrice        Float?
  proposedPrice       Float?
  currentTitle        String?
  proposedTitle       String?
  proposedDescription String? @db.Text

  confidence Int
  status     String
  error      String? @db.Text
  createdAt  DateTime
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([listingId, kind, status])
}

model EbayTokens {
  userId String @id

  env                   String
  accessToken           String   @db.Text
  refreshToken          String   @db.Text
  accessTokenExpiresAt  DateTime
  connectedAt           DateTime
  grantedScopes         String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Maps an opaque photo id to its owner. Exists because /api/photos/[id] must
/// stay public — eBay fetches listing images by URL and cannot present a
/// session — so the unguessable id is the capability, and the owner has to be
/// resolvable server-side without putting the userId in the URL.
model Photo {
  id          String   @id
  userId      String
  contentType String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A sale parsed out of a forwarded marketplace email.
///
/// Kept as its own row rather than written straight onto a Listing because
/// matching an email to a listing is a guess. A wrong guess marks the wrong
/// item sold, which both lies to the seller about their money and poisons the
/// playbook's training data — so anything short of a confident, unique match
/// waits here for a human.
model InboundSale {
  id     String @id @default(cuid())
  userId String

  itemTitle String  @db.Text
  price     Float?
  soldAt    DateTime?
  platform  String  @default("depop")

  /// Listing this was matched to, once matched.
  listingId String?
  /// "applied" when auto-matched and written through, "pending" when it needs
  /// a human to pick the listing, "dismissed" when the seller rejected it.
  status String @default("pending")
  /// Whether the forwarded mail actually looked like it came from the
  /// marketplace. False means treat the contents as unverified user input.
  verified Boolean @default(false)

  receivedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
