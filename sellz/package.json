{
  "name": "sellz",
  "version": "0.1.0",
  "private": true,
  "description": "Grade your marketplace listings on real sales, learn why items sell (or don't), generate better listings",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p ${PORT:-3002}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.110.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^11.18.2",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5"
  }
}
