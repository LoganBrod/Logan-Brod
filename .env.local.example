# Copy this file to .env.local and fill in your credentials.

# --- Sports card deal finder (eBay + PriceCharting) ---
# eBay developer account: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
# "sandbox" or "production" (default: production)
EBAY_ENV=production
# PriceCharting API token: https://www.pricecharting.com/api-documentation
PRICECHARTING_API_TOKEN=your_pricecharting_token

# --- Player social buzz (Reddit) ---
# Reddit "script" app: https://www.reddit.com/prefs/apps
# Optional — omitted credentials fall back to Reddit's unauthenticated public search,
# which is more rate-limited.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# --- NBA improving players (balldontlie) ---
# Free signup: https://www.balldontlie.io/
BALLDONTLIE_API_KEY=your_balldontlie_api_key

# --- Alerts (/alerts) ---
# Storage: add Upstash Redis via Vercel dashboard (Storage -> Marketplace -> Upstash);
# Vercel injects these automatically. For local dev, copy them from the Vercel project.
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Notifications: Discord webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=your_discord_webhook_url
# Optional: set to protect the cron endpoint; Vercel Cron sends it automatically.
CRON_SECRET=any_random_string
