# Copy to .env.local

# Required for AI hook + caption generation (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables Whisper transcription for burned-in captions.
# Without it, clips are still cut but ship without captions.
OPENAI_API_KEY=sk-...

# Optional: X (Twitter) posting — create an app at developer.x.com (free tier
# can post), generate keys with Read+Write, and add all four:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
