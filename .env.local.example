# Copy this file to .env.local and fill in your keys

# Roobet leaderboard (existing feature)
ROOBET_API_TOKEN=your_jwt_token_here

# Channel Diagnostics — YouTube
# Free API key: console.cloud.google.com → enable "YouTube Data API v3" → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Channel Diagnostics — Twitch
# Create an app at dev.twitch.tv/console → copy Client ID + generate a Client Secret
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Deep dive (your own channel's private analytics: watch time, retention,
# traffic sources). Google Cloud Console → OAuth consent screen → create an
# "OAuth client ID" (Web application) with redirect URI:
#   <your-site>/api/auth/youtube/callback  (e.g. http://localhost:3000/api/auth/youtube/callback)
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Optional: live web research for the improvement plan (free key at tavily.com).
# Without it, the improvement plan still works from curated, source-cited benchmarks.
TAVILY_API_KEY=
