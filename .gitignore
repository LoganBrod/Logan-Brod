# dependencies
# NOTE: no leading slash. "/node_modules" would only match at the repo root and
# would miss mcp/context-server/node_modules.
node_modules/
/.pnp
.pnp.js

# Next.js
# Unanchored, so this also covers dashboard/.next — same trap as node_modules.
.next/
out/

# production
/build

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# credentials — deny broadly, then re-allow the checked-in example file.
# Order matters: a later "!" rule un-ignores something an earlier rule caught.
.env*
!.env*.example
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
service-account*.json
token.json
secrets.*
*.secret

# local MCP / editor config that can hold tokens
.mcp.local.json
.claude/settings.local.json

# build output for the MCP server
mcp/context-server/build/
mcp/context-server/dist/
