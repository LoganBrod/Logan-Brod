{
  "name": "school-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The brain: scripts that read the School vault, call Claude, and file notes.",
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "ingest:dry": "tsx src/ingest.ts --dry-run",
    "ingest:fake": "tsx src/ingest.ts --dry-run --fake",
    "typecheck": "tsc --noEmit",
    "schoology": "tsx src/sync-schoology.ts",
    "schoology:dry": "tsx src/sync-schoology.ts --dry-run",
    "schoology:whoami": "tsx src/sync-schoology.ts --whoami",
    "materials": "tsx src/pull-materials.ts",
    "materials:dry": "tsx src/pull-materials.ts --dry-run",
    "sync": "npm run -s schoology && npm run -s materials && npm run -s ingest && npm run -s study && tsx src/plan-study.ts --if-configured && npm run -s home",
    "study": "tsx src/generate-study.ts",
    "home": "tsx src/build-home.ts",
    "update": "bash update.sh",
    "costs": "tsx src/costs.ts",
    "schedule": "bash schedule.sh",
    "unschedule": "bash schedule.sh remove",
    "plan": "tsx src/plan-study.ts",
    "plan:dry": "tsx src/plan-study.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "dotenv": "^17.4.2",
    "googleapis": "^181.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
