# Copy to .env and fill in. Never commit .env.

# Absolute path to your Obsidian vault folder (the one containing "00 Inbox").
# Windows example: C:\Users\you\Google Drive\School
# Mac example:     /Users/you/Google Drive/School
VAULT_PATH=

# From https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# Below this the brain files a note as "needs review" instead of moving it. 0 to 1.
CONFIDENCE_THRESHOLD=0.7

# Models. Sorting is routine; study material is where quality matters.
#   claude-opus-5 $5/$25 per M tokens · claude-sonnet-5 $2/$10 · claude-haiku-4-5 $1/$5
MODEL_SORT=claude-sonnet-5
MODEL_STUDY=claude-opus-5
MODEL_BRIEF=claude-sonnet-5
MODEL_CHAT=claude-sonnet-5

# Safety rails. Ingest stops calling Claude once a run has spent this much (USD);
# scanned PDFs over this many pages are held for you to split.
MAX_SPEND_PER_RUN=2
MAX_SCAN_PAGES=12

# Dashboard: your first name for the greeting, and the wake word for voice.
USER_NAME=
WAKE_WORD=jarvis

# Voice. Without ElevenLabs the browser's own voices are used; VOICE_NAME picks one by
# name (on a Mac, "Daniel" is the British one). With an ElevenLabs key (free tier is
# plenty), replies are spoken with a real voice; ELEVENLABS_VOICE_ID picks which.
VOICE_NAME=Daniel
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Schoology → click your name → API. These act as you; keep them out of git.
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=

# Schoology sections that are not classes (clubs, gym, advisory), comma-separated.
IGNORE_COURSES=

# Optional: a Discord channel webhook for "test posted" pings.
DISCORD_WEBHOOK_URL=

# Google service account key file (one file serves the planner and the Google Docs pull).
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json

# Study planner. STUDY_CALENDAR_ID is the calendar it writes into (share it with the service
# account, "Make changes to events"). For busy times use ONE of:
#   GOOGLE_CALENDAR_ID  a calendar shared with the service account ("See all event details")
#   BUSY_ICAL_URL       the calendar's "Secret address in iCal format", for school accounts that block sharing
STUDY_CALENDAR_ID=
GOOGLE_CALENDAR_ID=
BUSY_ICAL_URL=

# Optional: Google Docs pull. See README.
GDOCS_FOLDER_ID=

# ---- Your phone (optional) ----
# The morning brief is texted to you. Pick one:
#   iMessage (free): just PHONE_NUMBER, on a Mac signed into Messages. The brain asks the Messages app to send it.
#   Twilio (real SMS, about $2/month): PHONE_NUMBER plus the three TWILIO_ keys from console.twilio.com.
#   ntfy (free push, any phone): install the ntfy app, subscribe to a long random topic name, put it in NTFY_TOPIC.
# Test with: npm run brief:ping
PHONE_NUMBER=
# PHONE_CHANNEL=imessage      # or twilio, or none. Leave blank to pick automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NTFY_TOPIC=

# ---- Dashboard on Vercel (optional) ----
# Lets you open the dashboard and talk to the assistant from your phone anywhere.
# BLOB_READ_WRITE_TOKEN comes from the Blob store on your Vercel project (README → On your phone).
# After every sync the brain uploads a private copy of the vault there; the app on Vercel reads that copy.
BLOB_READ_WRITE_TOKEN=
# Set the same DASHBOARD_PASSWORD in Vercel's environment variables. It is the login for the site.
# Leave it blank here so the dashboard on this computer stays password-free.
DASHBOARD_PASSWORD=
