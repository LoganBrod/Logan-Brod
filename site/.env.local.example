# Copy to .env.local and fill in. ANTHROPIC_API_KEY and the eBay pair are all
# you need for a full run; the rest unlock saving and retail listings.

# --- Claude (style analysis, curation, outfits) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- eBay Browse API (primary shopping source) ---
# https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# "sandbox" or "production" (default: production)
EBAY_ENV=production

# --- Google Shopping via SerpAPI (optional second source) ---
# https://serpapi.com/manage-api-key — leave blank to run eBay-only.
SERPAPI_KEY=

# --- Sign-in emails (Resend) ---
# https://resend.com/api-keys — optional. Without these, accounts still work
# locally: the sign-in link is printed to the server console instead of sent.
# In production, unset means no sign-in at all and the app stays anonymous.
RESEND_API_KEY=
# The From address. Until you verify a domain in Resend you can only send from
# onboarding@resend.dev, and only to the address you signed up with — enough to
# test the flow. Verify a domain (Resend -> Domains -> Add Domain, then add the
# TXT/MX records at your DNS host) to send from your own. A *.vercel.app
# subdomain can't be verified; domain verification needs DNS records you control.
MAIL_FROM=Closet <onboarding@resend.dev>

# --- Standing searches ---
# The scheduled sweep at /api/cron/sweep refuses every request without this, so
# an endpoint that spends money on model calls is never left open. Vercel sends
# it automatically for crons in vercel.json; generate any long random string.
CRON_SECRET=

# Comma-separated addresses that get membership without paying, until there's a
# payment provider. Everything else about billing is grantPlan in lib/plans.ts.
MEMBER_EMAILS=

# --- Saved closets, accounts, and taste (Upstash Redis) ---
# Vercel dashboard -> Storage -> Marketplace -> Upstash Redis. Injected
# automatically on Vercel; copy them here for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Photos need no storage service: they are downscaled in the browser and sent
# to Claude inline, never hosted.

# --- Deployment ---
# The site's public origin, e.g. https://clozet.example.com - no trailing slash.
# Required in production for sign-in links. They used to be built from the
# request's Host header, which anyone can set; a link is only sent to the
# address that asked for it, so it has to point at a domain you control.
APP_ORIGIN=
# Shared secret the scheduler sends as "Authorization: Bearer <secret>" to
# /api/cron/sweep. Unset means that endpoint is closed, not open.
CRON_SECRET=
